# ------------------------------------------------------------------
# Lumo Lab — LiteSpeed / Apache rewrite rules
# ------------------------------------------------------------------
RewriteEngine On

# 1) Force HTTPS (301)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2) Legacy URL redirects (301, permanent). QSA preserves query strings.
#    Old /project/<slug> case-study URLs from the previous site → current /work/<slug>.
#    Slugs are 1:1 with current case studies, so the mapping is unambiguous.
RewriteRule ^project/(nomo|farmwave|muvr|noctrix|beunity|drift|mobility|crossiety)/?$ /work/$1 [R=301,L,QSA]
#    Legacy /services alias → canonical /for-clients
RewriteRule ^services/?$ /for-clients [R=301,L,QSA]

# 3) Serve real files and pre-rendered route directories as-is (HTTP 200).
#    react-snap emits one directory per valid route (see package.json > reactSnap.include),
#    so valid deep links resolve to their own pre-rendered index.html here.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 4) Known client-side routes → serve the SPA shell (HTTP 200).
#    Sub-IDs (e.g. /work/<id>, /blog/<slug>) are validated inside the app;
#    invalid sub-IDs render the branded 404 component (noindex) client-side.
RewriteRule ^(about|for-clients|work|blog|careers|press|privacy-policy|contact|app-cost-calculator)(/.*)?$ /index.html [L]
RewriteRule ^$ /index.html [L]

# 5) Everything else is an unknown URL → real HTTP 404.
#    ErrorDocument serves the SPA shell, which client-routes to the branded
#    "Page not found" component (noindex,nofollow) while the response keeps status 404.
ErrorDocument 404 /index.html
RewriteRule ^ - [R=404,L]
