{
  "name": "lumo-lab",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://lumo-lab.com",
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "react-snap",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "reactSnap": {
    "source": "build",
    "include": [
      "/",
      "/about",
      "/for-clients",
      "/work",
      "/work/nomo",
      "/work/farmwave",
      "/work/muvr",
      "/work/noctrix",
      "/work/beunity",
      "/work/drift",
      "/work/mobility",
      "/work/crossiety",
      "/blog",
      "/blog/nomo-smart-care-case-study",
      "/blog/deep-learning-audio-classification",
      "/blog/ai-on-microcontrollers",
      "/careers",
      "/careers/open",
      "/press",
      "/contact",
      "/app-cost-calculator",
      "/privacy-policy"
    ],
    "skipThirdPartyRequests": true,
    "inlineCss": true,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "headless": true,
    "removeBlobs": true,
    "fixWebpackChunksIssue": "CRA2",
    "crawl": false
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "husky": "^4.3.8",
    "react-snap": "^1.23.0"
  }
}
